{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workbench.local/schemas/renderer/workbench.renderer-1.json",
  "title": "Workbench RendererManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "renderer", "display_name", "supported_kinds", "view_model_version"],
  "properties": {
    "schema_version": {"const": "workbench.renderer/1"},
    "renderer": {"$ref": "#/$defs/renderer_ref"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
    "supported_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["asset", "skill", "artifact", "entity", "task", "approval", "group", "composite", "legacy"]}},
    "view_model_version": {"type": "string", "minLength": 1, "maxLength": 120},
    "supports_ports": {"type": "boolean", "default": true},
    "supports_selection": {"type": "boolean", "default": true},
    "supports_resize": {"type": "boolean", "default": true}
  },
  "$defs": {
    "renderer_ref": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 255}, "version": {"type": "string", "minLength": 1, "maxLength": 120}}}
  }
}
